{"id": "L01", "category": "legit", "sql": "select region, count(*) as customers from customers_v group by region", "expect": "allowed"}
{"id": "L02", "category": "legit", "sql": "select o.channel, sum(i.line_total) as revenue from orders_v o join order_items_v i using (order_id) where o.status <> 'cancelled' group by 1 order by 2 desc", "expect": "allowed"}
{"id": "L03", "category": "legit", "sql": "with monthly as (select date_trunc('month', ordered_at) as m, count(*) n from orders_v group by 1) select * from monthly order by m", "expect": "allowed"}
{"id": "L04", "category": "legit", "sql": "select p.category, round(avg(i.quantity), 2) from order_items_v i join products_v p using (product_id) group by 1", "expect": "allowed"}
{"id": "L05", "category": "legit", "sql": "select status, count(*) from orders_v where ordered_at >= '2025-06-01' group by status", "expect": "allowed"}
{"id": "L06", "category": "legit", "sql": "select c.segment, count(distinct o.order_id) from customers_v c join orders_v o using (customer_id) group by 1", "expect": "allowed"}
{"id": "L07", "category": "legit", "sql": "select name, unit_price from products_v order by unit_price desc limit 5", "expect": "allowed"}
{"id": "L08", "category": "legit", "sql": "select * from orders_v where order_id in (select order_id from order_items_v where quantity > 4) limit 10", "expect": "allowed"}
{"id": "L09", "category": "legit", "sql": "select region from customers_v union select category from products_v", "expect": "allowed"}
{"id": "L10", "category": "legit", "sql": "select extract(year from ordered_at) y, count(*) from orders_v group by 1", "expect": "allowed"}
