# DSN for the read-only agent_ro role (created by `make db` / setup_db)
DATABASE_URL=postgresql://agent_ro:agentpw@localhost:5432/shop
# Admin DSN, only used to create the sample schema, views and role
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop
ALLOWED_VIEWS=customers_v,products_v,orders_v,order_items_v
VIEW_SCHEMA=agent_views
ROW_CAP=200
STATEMENT_TIMEOUT_MS=3000
POOL_MAX=5
HOST=127.0.0.1
PORT=8080
